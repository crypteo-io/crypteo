# Keep the password here in sync with POSTGRES_PASSWORD below.
DATABASE_URL="postgresql://crypteo_user:change-me@postgres:5432/Crypteo"

NEXTAUTH_SECRET="change-me-64-random-chars"

# Encrypts authenticator-app (TOTP) secrets at rest; at least 32 characters,
# e.g. `openssl rand -base64 48`. Unset, the authenticator option is hidden and
# everyone signs in with emailed codes. NEVER rotate it casually: every enrolled
# authenticator stops verifying (recover with scripts/reset-two-factor.ts).
TWO_FACTOR_ENCRYPTION_KEY=""
# Public base URL. Also gives the monitor the hostname it sends as SNI when
# probing nginx over HTTPS and checking the origin certificate.
NEXTAUTH_URL="https://crypteo.io"

# Cloudflare Turnstile. The site key MUST use the NEXT_PUBLIC_ prefix — it is
# inlined into the client bundle at BUILD time (a missing/empty value throws
# "Invalid input for parameter sitekey" in the browser). In Docker it must be
# passed as a build arg (see docker-compose.yml), not just at runtime.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Example: Cloudflare Email Service:
# implicit TLS on 465, username literally "api_token", password a Cloudflare
# API token with Email Sending: Edit. Port 465 means implicit TLS; any other
# port must offer STARTTLS (lib/mailer.ts smtpOptions).
SMTP_HOST="smtp.mx.cloudflare.net"
SMTP_PORT="465"
SMTP_USER="api_token"
SMTP_PASS="change-me"
SMTP_FROM="Crypteo <noreply@crypteo.io>"

POSTGRES_DB="Crypteo"
POSTGRES_USER="crypteo_user"
POSTGRES_PASSWORD="change-me"
# Seed Admin Credentials (use a strong, unique password)
SEED_ADMIN_EMAIL="admin@crypteo.io"
SEED_ADMIN_NAME="Platform Administrator"
SEED_ADMIN_PASSWORD="change-me"
# Demo merchant password for local seeding (random and printed once if unset).
# Demo data is never seeded in production.
SEED_DEMO_PASSWORD=""
# The seed refuses NODE_ENV=production unless this is "true" (deploy.sh sets it
# for SEED=true). In production it only ensures the admin account exists.
SEED_ALLOW_PRODUCTION="false"

# Local development only: skip the email OTP step at login. Ignored whenever
# NODE_ENV=production.
ALLOW_DEV_LOGIN_BYPASS="false"

# Playground public test API key (pre-loaded for unauthenticated visitors)
# This must be a test-mode key (isTest: true). It is server-side only — never use NEXT_PUBLIC_ prefix.
PLAYGROUND_PUBLIC_TEST_KEY="test_change-me"

# ─── Chain RPC endpoints ──────────────────────────────────────────────────────
# Comma-separated, best first. Each REPLACES the built-in default list; leave
# unset to use the defaults.
#
# Strongly recommended in production. The built-in defaults are free public
# endpoints, and free public endpoints degrade without notice: they start
# requiring a key, they gate the "expensive" methods, or they simply go away.
# `solana.publicnode.com` serves getSlot but refuses getTokenAccountsByOwner —
# the call that reads an SPL (USDC/USDT) balance — which made every Solana
# stablecoin deposit undetectable. `eth.llamarpc.com` and `rpc.ankr.com/eth`
# were both dead in the ETH default list for an unknown length of time.
#
# The worker probes every chain/token pair's balance read at startup and every
# CHAIN_PROBE_CRON, and emails ADMIN_EMAILS the moment one stops working. Point these at a keyed
# provider (Helius, QuickNode, Alchemy, drpc) before taking real merchant
# traffic.
# List SEVERAL providers per chain. Requests rotate across them, so free tiers
# combine: each one carries a share of the load instead of one hitting its
# rate limit. Refusals are remembered per method, so an endpoint that only
# serves some methods still pulls its weight on the rest.
#
# Free tiers worth signing up for (no card required at time of writing):
#   Solana — Helius (1M credits/mo), Alchemy, QuickNode
#   ETH    — Alchemy (30M CU/mo), Infura, QuickNode
#
# SOLANA_RPC_URLS="https://mainnet.helius-rpc.com/?api-key=KEY1,https://solana-mainnet.g.alchemy.com/v2/KEY2,https://api.mainnet-beta.solana.com"
# ETH_RPC_URLS="https://eth-mainnet.g.alchemy.com/v2/KEY,https://mainnet.infura.io/v3/KEY,https://rpc.mevblocker.io"
# BTC_API_URLS="https://mempool.space/api,https://blockstream.info/api"
# XRP_RPC_URLS="https://xrplcluster.com,https://xrpl.ws,https://s2.ripple.com:51234,https://s1.ripple.com:51234"
# BSC_RPC_URLS="https://bsc-rpc.publicnode.com,https://bsc.drpc.org"
# POLYGON_RPC_URLS="https://rpc-mainnet.matic.quiknode.pro,https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org"
#
# Tron: TRON_RPC_URLS serves balances (full-node /wallet API); TRON_INDEXER_URLS
# serves transaction lookups (/v1, TronGrid-compatible only). TronGrid throttles
# anonymous callers hard — a free key (trongrid.io) is sent only to TronGrid.
# TRON_RPC_URLS="https://api.trongrid.io,https://tron-rpc.publicnode.com"
# TRON_INDEXER_URLS="https://api.trongrid.io"
# TRON_API_KEY=""
#
# Dogecoin / Zcash: any Blockbook /api/v2 base URL (NowNodes, GetBlock,
# self-hosted). Zcash has ONE key-free default — add a second in production.
# NowNodes (free tier, nownodes.io) needs NOWNODES_API_KEY, sent as the
# `api-key` header to *.nownodes.io only; without it zecbook.nownodes.io
# answers 401 and rotation falls back to the other endpoints.
# DOGE_API_URLS="https://blockbook.doge.zelcore.io,https://dogecoin.atomicwallet.io"
# ZEC_API_URLS="https://blockbook.zec.zelcore.io,https://zecbook.nownodes.io"
# NOWNODES_API_KEY=""
#
# Cardano: Koios-compatible base URLs. A free Koios token raises rate limits and
# is sent only to koios.rest.
# KOIOS_API_URLS="https://api.koios.rest/api/v1"
# KOIOS_API_TOKEN=""

# Schedule (cron syntax) for the worker's chain read readiness probe.
# Default: "*/15 * * * *". The monitor treats a probe older than 50 minutes as
# stale, so keep it well under that.
# CHAIN_PROBE_CRON="*/15 * * * *"

# Outbound proxies are managed on admin Proxies (stored encrypted under
# TWO_FACTOR_ENCRYPTION_KEY), not here. PROXIES is read only by the one-off
# import: docker compose exec app npx tsx scripts/import-proxies.ts
# PROXIES="http://user:pass@proxy1.example:8080,http://user:pass@proxy2.example:8080"
# How often the worker health-checks every proxy (default every 5 minutes).
# PROXY_CHECK_CRON="*/5 * * * *"

# Monitoring
# Comma-separated list of admin emails to receive alerts and routine reports
ADMIN_EMAILS="admin@crypteo.io"

# Comma-separated mailboxes that also receive every ADMIN account's emailed
# login and password-reset codes (merchants' codes are never copied). Use while
# an admin's own mailbox can't receive mail. Each address gets its own message.
# ADMIN_OTP_COPY_EMAILS="you@example.com"

# Release identifier — baked in as Next.js deploymentId for skew protection so
# stale browser tabs reload instead of erroring after a redeploy. Bump per release.
APP_VERSION="1.0.0"

# Stable key for Next.js Server Actions. Only required once you add server actions
# AND run more than one `app` replica (or want IDs stable across rebuilds).
# Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ─── Webhook SSRF guard ───────────────────────────────────────────────────────
# This host's own public IPv4/IPv6 addresses. They pass every private-range
# check, yet a webhook aimed at them reaches services on this machine (sshd,
# anything bound to 0.0.0.0), so webhook delivery refuses them explicitly.
WEBHOOK_BLOCKED_IPS="203.0.113.10,2001:db8::1"

# ─── Backups ──────────────────────────────────────────────────────────────────
# Nightly dumps (postgres/backup.sh) are kept ONLY on this host by default — a
# lost disk or host takes every restore point with it. Set this to copy each
# verified dump somewhere else. It runs in the `backup` container via `sh -c`,
# with the dump's path as $1 (also exported as BACKUP_FILE); a non-zero exit is
# recorded in last_backup.json and alerts admins through the monitor. The
# container is postgres:16-alpine, so the command may only use tools present
# there (sh, busybox wget, …) or tools you add to that image.
# BACKUP_OFFSITE_CMD='scp -i /keys/offsite "$1" backup@offsite.example:/srv/crypteo/'
# Seconds before a hung offsite copy is killed and reported as failed.
# BACKUP_OFFSITE_TIMEOUT="3600"

# Custom domains for payment links (lib/custom-domain.ts, caddy/Caddyfile).
# Merchants CNAME their subdomain to CUSTOM_DOMAIN_TARGET (default
# domains.<NEXTAUTH_URL host>; a DNS-only record pointing at this server).
# Caddy holds the public 80/443 for those hostnames and gets their
# certificates from Let's Encrypt (CADDY_HTTP_BIND / CADDY_HTTPS_BIND to move it).
# Enable it with COMPOSE_PROFILES=custom-domains.
CUSTOM_DOMAIN_TARGET=""
COMPOSE_PROFILES=""

# Telegram bot (lib/telegram, optional: without a token the feature is hidden).
# Create the bot with @BotFather, fill these in, then run once:
#   docker compose exec app npx tsx scripts/telegram-setup.ts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Telegram sends this back on every update. Letters, numbers, _ and - only:
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
