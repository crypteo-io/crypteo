generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                  String            @id @default(cuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  name                String
  email               String            @unique
  password            String
  role                String            @default("merchant")
  isActive            Boolean           @default(true)
  emailVerified       DateTime?
  // Sessions authenticated before this instant are revoked (lib/auth.ts
  // revalidateToken). Set on password reset/change and on self-delete.
  passwordChangedAt   DateTime?
  // Unused since password reset moved to OTP codes. Kept one more release so a
  // rollback to v1.0.37 (whose client selects them) still works; drop after.
  resetToken          String?
  resetTokenExpiresAt DateTime?
  // Deprecated: copied into WebhookEndpoint by 20261015140000_webhook_endpoints
  // and no longer read. Drop in a later release.
  defaultWebhookUrl   String?
  webhookSecret       String?
  // received/expected ratio at or above which a payment is fully paid; below it,
  // underpaid. Configurable per merchant (default matches PAYMENT_TOLERANCE).
  underpaidThreshold  Float             @default(0.99)
  // Sessions authenticated before this instant are revoked, like
  // passwordChangedAt, but set by an admin's "sign out everywhere".
  sessionsRevokedAt   DateTime?
  // Second login factor: "email" (a code mailed at step one) or "totp" (an
  // authenticator app). Secrets are AES-GCM encrypted (lib/two-factor.ts).
  twoFactorMethod     String            @default("email")
  totpSecret          String?
  // Generated by setup, promoted to totpSecret once a code from it verifies.
  totpPendingSecret   String?
  // Last accepted 30s TOTP step: a code is never accepted twice.
  totpLastUsedStep    Int?
  // Hosted checkout theme colour, "#rrggbb" (lib/branding.ts). Null = Crypteo's.
  brandColor          String?
  logo                MerchantLogo?
  // Checkout footer (lib/branding.ts): the merchant's support address, an
  // optional labelled https link, and whether "Powered by Crypteo" shows.
  supportEmail        String?
  supportLinkLabel    String?
  supportLinkUrl      String?
  showPoweredBy       Boolean   @default(false)
  // A hostname of the merchant's (CNAME to us) serving their payment links
  // once the TXT record proves they own it (lib/custom-domain.ts).
  customDomain           String?   @unique
  customDomainToken      String?
  customDomainVerifiedAt DateTime?
  // Set while a platform fee invoice is overdue (lib/billing/statements.ts):
  // no checkout can be bound to a network. The merchant still signs in, to pay.
  billingHoldAt       DateTime?
  // Never charged platform fees (the platform's own apps, partners). Set only
  // through the admin API with a reason, announced to every other admin
  // (app/api/admin/merchants/[id], guarded by lib/billing/exemption.test.ts).
  feeExempt           Boolean           @default(false)
  feeExemptReason     String?
  feeExemptBy         String?
  feeExemptAt         DateTime?
  // Sales before this are never billed: set when an exemption ends, so the
  // exempt period isn't billed in arrears at the next close.
  feesFromAt          DateTime?
  apiKeys             ApiKey[]
  payments            Payment[]
  paymentLinks        PaymentLink[]
  wallets             Wallet[]
  blogPosts           BlogPost[]
  webhookEndpoints    WebhookEndpoint[]
  notifications       Notification[]
  feeStatements       FeeStatement[]
  trustedDevices      TrustedDevice[]
}

// The merchant's checkout logo, re-encoded by lib/branding-logo.ts. Its own
// table so the bytes never ride along on a Merchant read. Every upload gets a
// new id, which is what lets /api/brand-logo/[id] be cached as immutable.
model MerchantLogo {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  merchantId  String   @unique
  contentType String
  width       Int
  height      Int
  data        Bytes
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

// A merchant's webhook receivers (one per site). Every payment is delivered
// to exactly one URL (lib/payment/notify.ts webhookTarget): its own, the
// endpoint its link or API key names, or the merchant's default endpoint.
model WebhookEndpoint {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchantId String
  url        String
  label      String?
  isActive   Boolean  @default(true)
  // At most one per merchant (enforced by the API): where payments with no
  // other destination are sent.
  isDefault  Boolean  @default(false)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, url])
}

model Wallet {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  merchantId String
  chain      String
  token      String
  address    String
  isActive   Boolean  @default(true)
  xrpTag     String? // XRP Destination Tag (numeric identifier for shared wallets)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, chain, token])
}

model Payment {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  merchantId          String
  chain               String?
  token               String?
  expectedAmount      Float
  walletAddress       String?
  balanceSnapshot     Float     @default(0)
  snapshotAt          DateTime? // when balanceSnapshot was read (chain assignment)
  // What balanceSnapshot measures, when the adapter has more than one notion
  // of "balance" over time. Null = the adapter's legacy basis (for BTC:
  // lifetime funded_txo_sum); "balance" = confirmed balance.
  snapshotBasis       String?
  status              String    @default("pending")
  txHash              String?   @unique
  receivedAmount      Float?
  confirmations       Int       @default(0)
  nextPollAt          DateTime?
  pollInterval        Int       @default(15)
  lastPolledAt        DateTime?
  // When this session first observed its deposit on-chain. Immutable once set:
  // it anchors both the age-derived confirmation count (lib/chains/config.ts
  // confirmationsFromAge) and the stuck-in-confirming timeout, neither of which
  // can key off updatedAt because every poll refreshes it.
  firstDetectedAt     DateTime?
  pollPhase           String    @default("phase1")
  externalId          String?
  webhookUrl          String?
  // The merchant's pages checkout sends the buyer to once paid, or back to
  // when they leave (public API successUrl/cancelUrl, http(s) only).
  successUrl          String?
  cancelUrl           String?
  // The endpoint chosen by its payment link or API key, copied at creation;
  // null = the merchant's default endpoint. Not a foreign key, see ApiKey.
  webhookEndpointId   String?
  webhookSentAt       DateTime?
  webhookAttempts     Int       @default(0)
  nextWebhookRetryAt  DateTime?
  metadata            Json?
  customerEmail       String?
  emailSentAt         DateTime?
  expiresAt           DateTime
  paymentLinkId       String?
  isTest              Boolean   @default(false)
  xrpDestinationTag   String? // XRP Destination Tag for payment tracking
  senderAddress       String? // FROM address of attributed transaction
  solMemoString       String? // Solana memo string for per-session attribution
  // The fee statement this sale was billed in: each paid payment is billed
  // exactly once (lib/billing/statements.ts closeMonth stamps it).
  billedInStatementId String?
  // Set on a checkout session that pays a fee statement (the platform billing
  // account's own session); only USDT/USDC are offered on it.
  feeForStatementId   String?

  // Restrict, not Cascade: payments are the financial record and must outlive
  // any attempt to delete their merchant (self-delete is a soft delete).
  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)

  @@index([status, firstDetectedAt])
  @@index([status, nextPollAt])
  @@index([merchantId])
  @@index([txHash])
  @@index([externalId])
  @@index([walletAddress, chain, token, status])
  @@index([nextWebhookRetryAt])
  @@index([billedInStatementId])
  @@index([feeForStatementId])
}

model ApiKey {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  merchantId        String
  keyHash           String    @unique
  keyPrefix         String
  label             String?
  lastUsedAt        DateTime?
  isActive          Boolean   @default(true)
  isTest            Boolean   @default(false)
  // Payments this key creates go to this endpoint (one key per site). Not a
  // foreign key: a deleted endpoint must leave its payments undelivered, never
  // fall through to another site's default.
  webhookEndpointId String?
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model PaymentLink {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  merchantId        String
  title             String
  description       String?
  amount            Float
  walletAddress     String?
  chain             String?
  token             String?
  // Where this link's payments send webhooks: a custom URL, or one of the
  // merchant's endpoints (not a foreign key, see ApiKey). Neither = default.
  webhookUrl        String?
  webhookEndpointId String?
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  paymentLimit      Int?
  paymentsCount     Int       @default(0)

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([merchantId])
}

model EmailLog {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  paymentId String
  type      String
  recipient String
  subject   String
  sentAt    DateTime?
  error     String?
}

model WebhookLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  paymentId  String
  url        String
  payload    Json
  statusCode Int?
  response   String?
  attempt    Int      @default(1)
  success    Boolean  @default(false)

  // The merchant dashboard reads a merchant's recent deliveries by payment.
  @@index([paymentId, createdAt])
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String // OtpType (lib/otp.ts)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

// A browser that passed a sign-up or login code for this account, so its
// logins skip the code until expiresAt unless suspicious (lib/trusted-device.ts).
// tokenHash is the SHA-256 of the browser's random device cookie.
model TrustedDevice {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tokenHash  String
  country    String?
  trustedAt  DateTime
  expiresAt  DateTime

  @@unique([merchantId, tokenHash])
  @@index([merchantId, trustedAt])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// A balance read that failed while opening a payment. The buyer is shown a
// generic retry message, so without this the failure would be invisible to
// operators; the monitor alerts on these and the cause is kept server-side.
model ChainReadFailure {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  chain     String
  token     String
  context   String
  message   String

  @@index([createdAt])
}

model OrphanTransaction {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  txHash              String    @unique
  walletAddress       String
  chain               String
  token               String
  receivedAmount      Float
  blockTime           DateTime?
  resolvedByAdmin     Boolean   @default(false)
  resolvedToPaymentId String?
  resolvedAt          DateTime?
  notes               String?

  @@index([walletAddress, chain, token])
  @@index([resolvedByAdmin])
}

// Liveness beacon for the standalone worker process (workers/scheduler.ts).
// The worker is what actually detects payments, but it serves no HTTP surface,
// so nothing could observe it stalling. It stamps this singleton row on every
// poll cycle; /api/health reports the age and the monitor alerts on staleness.
model WorkerHeartbeat {
  id             String   @id @default("worker")
  updatedAt      DateTime @updatedAt
  lastCycleAt    DateTime
  cycleDuration  Int      @default(0)
  pollsLastCycle Int      @default(0)
  lastError      String?

  // Chain read-path readiness, written by the worker's periodic probe. A live
  // worker polling a chain it cannot read looks identical to a healthy one.
  chainsCheckedAt DateTime?
  chainsHealthy   Boolean?
  // "chain/token" pairs that failed their probe, comma-separated.
  chainsDegraded  String?
}

/// Every account change an admin makes to a merchant, newest first on the
/// merchant's admin page. adminEmail is copied so the trail survives the
/// admin account being renamed or deleted.
model AdminAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  adminId    String
  adminEmail String
  merchantId String
  action     String
  details    Json?

  @@index([merchantId, createdAt])
}

// A blog post, written by an admin in /dashboard/blog. content is Markdown,
// rendered and sanitised on the server (lib/blog/markdown.ts). status is
// "draft" | "published"; publishedAt is set on first publish and kept when a
// post is unpublished, so re-publishing doesn't move it to the top.
model BlogPost {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  slug          String            @unique
  title         String
  excerpt       String
  content       String
  // "html" (the rich-text editor, sanitised on render) or "markdown" (posts
  // written before it; rendered by marked, then the same sanitiser).
  format        String            @default("markdown")
  coverImageUrl String?
  status        String            @default("draft")
  publishedAt   DateTime?
  authorId      String
  versions      BlogPostVersion[]
  // Restrict: admin accounts are soft-deleted, never removed, so a post never
  // loses its author row.
  author        Merchant          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@index([authorId])
}

// A snapshot of a post taken on every save (lib/blog/versions.ts), newest
// kept up to MAX_VERSIONS_PER_POST. Restoring loads one into the editor; it
// becomes current only when saved, which records a new version.
model BlogPostVersion {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  postId        String
  // Admin account id; no relation, so a version outlives nothing it needs.
  createdBy     String
  // "create" | "save" | "publish" | "unpublish"
  event         String
  title         String
  slug          String
  excerpt       String
  content       String
  format        String
  coverImageUrl String?
  status        String
  post          BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// Images uploaded to the blog gallery, re-encoded by lib/images.ts. Bytes in
// their own table like MerchantLogo; served publicly at /api/blog-media/[id].
model BlogMedia {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  uploadedBy  String
  contentType String
  width       Int
  height      Int
  sizeBytes   Int
  alt         String?
  data        Bytes

  @@index([createdAt])
}

/// An outbound HTTP(S) proxy for chain and price reads (lib/proxy-rotation.ts),
/// managed on admin Proxies. `url` holds credentials, so it is stored
/// AES-256-GCM encrypted (lib/proxy-settings.ts); the app and the worker load
/// the active rows into their rotation every minute, and the worker checks
/// each one's health (lib/proxy-health.ts).
model OutboundProxy {
  id        String   @id @default(cuid())
  url       String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The worker's health check (lib/proxy-health.ts): a real request through
  // the proxy every few minutes. lastError never holds the credentials.
  lastCheckedAt       DateTime?
  lastOkAt            DateTime?
  lastLatencyMs       Int?
  lastError           String?
  consecutiveFailures Int       @default(0)
  // Alert hysteresis: a failing alert opens, a recovered alert closes it, and
  // a proxy alerts at most once per PROXY_ALERT_COOLDOWN_MS however it flaps.
  alertOpen           Boolean   @default(false)
  lastAlertAt         DateTime?
}

/// Platform-wide settings edited by admins (one row, id "platform").
/// Fee tiers drive both billing and every fee figure on the public site.
model PlatformSettings {
  id                    String    @id @default("platform")
  updatedAt             DateTime  @updatedAt
  updatedBy             String?
  // [{ fromUsd, percent }], ascending fromUsd, first at 0: the month's paid
  // volume picks one rate for the whole month (lib/billing/fee-schedule.ts).
  feeTiers              Json
  // Most a merchant is charged for one month; null = no cap.
  feeMonthlyCapUsd      Float?
  // Nothing is invoiced below this; it carries into the next month.
  feeMinInvoiceUsd      Float     @default(0)
  // Owed at or above this is invoiced monthly; below it, every 3 billing
  // months (lib/billing/fee-schedule.ts shouldInvoice). null = every 3 months.
  feeMonthlyInvoiceUsd  Float?    @default(100)
  // Below that threshold, billing months fees accrue before an invoice.
  feeInvoiceEveryMonths Int       @default(3)
  // Monthly invoicing runs only while enabled; sales before feesStartAt are
  // never billed (enabling must not bill a merchant's whole history).
  billingEnabled        Boolean   @default(false)
  feesStartAt           DateTime?
  // The account whose USDT/USDC wallets receive fee payments.
  billingMerchantId     String?
}

/// One merchant's platform fees for one billing month: their own cycle,
/// anchored on the day the account was created (lib/billing/cycle.ts).
model FeeStatement {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  merchantId     String
  periodStart    DateTime
  periodEnd      DateTime
  paymentCount   Int
  volumeUsd      Float
  ratePercent    Float
  // This month's fee after the monthly cap.
  feeUsd         Float
  // Earlier statements below the minimum, rolled into this one.
  carriedInUsd   Float     @default(0)
  amountDueUsd   Float
  // carried | open | paid | waived (lib/billing/statements.ts)
  status         String
  // A carried statement's successor, which now owes its amount.
  carriedIntoId  String?
  // Start of the oldest month whose fees this statement owes (its own
  // periodStart unless it carried earlier ones in).
  accruingSince  DateTime?
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  // The fee checkout session that paid it, or the admin's note.
  paidPaymentId  String?
  resolvedBy     String?
  note           String?
  // Reminders, each sent at most once (lib/billing/notices.ts).
  noticeIssuedAt DateTime?
  notice72hAt    DateTime?
  notice24hAt    DateTime?
  noticeHoldAt   DateTime?

  // Restrict: a statement is a financial record (accounts are soft-deleted).
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([merchantId, periodStart])
  @@index([status, dueAt])
  @@index([merchantId, createdAt])
}

/// In-app notifications (the dashboard bell). Written only through
/// lib/notifications.ts, which keeps operational alerts away from merchants.
model Notification {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  // The account it is for: a merchant, or one admin account.
  merchantId String
  // A kind from lib/notifications.ts (MERCHANT_KINDS / ADMIN_KINDS).
  kind       String
  title      String
  body       String
  // Dashboard path to open, e.g. "/dashboard/payments/<id>".
  link       String?
  readAt     DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, readAt, createdAt])
  @@index([merchantId, createdAt])
}

/// Contact-form submissions, reviewed on the admin Contact page. Anonymous
/// input: rendered as text only, never as HTML.
model ContactMessage {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  name      String
  email     String
  subject   String?
  message   String
  ip        String?
  // When an admin dealt with it, and who.
  handledAt DateTime?
  handledBy String?

  @@index([handledAt, createdAt])
  @@index([createdAt])
}
